#!/bin/sh
# RoboFrame environment for RoboPi running RoboOH 1.0.1
# Usage: . /data/roboframe/scripts/robooh_1.0.1.env
#
# Eliminates /data/local/skh-run — all deps in /data/roboframe/pysite/
# and system libs in /sys_prod/robot/out/lib/

# LD_PRELOAD system libpython (required by Python C extensions on RoboOH 1.0.1)
export LD_PRELOAD=/sys_prod/robot/out/lib/libpython3.12.so.1.0

# PATH (include /system/bin for env, toybox etc.)
export PATH=/sys_prod/robot/install/bin:/sys_prod/robot/out/bin:/system/bin:/data/roboframe/install/bin:$PATH

# ROS log dir (rootfs is read-only, redirect to /data)
export ROS_LOG_DIR=/data/local/tmp/ros_logs
mkdir -p "$ROS_LOG_DIR" 2>/dev/null

# HOME redirect to writable /data (rootfs is read-only)
export HOME=/data/root
mkdir -p "$HOME/.calibrate" "$HOME/.cache/torch/hub/checkpoints" 2>/dev/null

# Root for robot configuration paths such as relative inference model bundles
export WORKSPACE=/data/roboframe

# Load the OpenHarmony-native Houmo NPU driver if not already loaded.
if [ -f /data/local/houmo-sdk/xh2a_drv.ko ] && ! lsmod 2>/dev/null | grep -q xh2a_drv; then
    insmod /data/local/houmo-sdk/xh2a_drv.ko 2>/dev/null
fi

# Native libs (patches first to override system ros2_control fix)
export LD_LIBRARY_PATH=/data/roboframe/syslib:/data/roboframe/install/patches/lib:/data/roboframe/pysite/rpds_py.libs:/sys_prod/robot/out/lib:/sys_prod/robot/install/lib:/data/roboframe/install/ibrobot_msgs/lib:/data/roboframe/install/tensormsg/lib:/data/roboframe/install/embodied_common/lib:/data/roboframe/install/robot_config/lib:/data/roboframe/install/inference_service/lib:/data/roboframe/install/hardware_mock/lib:/data/roboframe/install/action_dispatch/lib:/data/roboframe/install/feetech_sdk/lib:/data/roboframe/install/so101_sdk/lib:/data/roboframe/install/so101_hardware/lib:/data/roboframe/install/so101_description/lib:/data/roboframe/install/so101_motion/lib:/data/roboframe/install/so101_suite/lib:/data/roboframe/install/so101_robot/lib:/data/roboframe/install/robot_runtime/lib:/data/roboframe/install/task_dispatch/lib:/data/roboframe/install/dataset_tools/lib:$LD_LIBRARY_PATH

# Python packages: pysite(torch+deps) -> lerobot -> roboframe packages -> system
export PYTHONPATH=/data/roboframe/pysite:/data/roboframe/install/lerobot/src:/data/roboframe/install/ibrobot_msgs/lib/python3.12/site-packages:/data/roboframe/install/tensormsg/lib/python3.12/site-packages:/data/roboframe/install/embodied_common/lib/python3.12/site-packages:/data/roboframe/install/inference_manifest/lib/python3.12/site-packages:/data/roboframe/install/ibrobot_tracing/lib/python3.12/site-packages:/data/roboframe/install/robot_config/lib/python3.12/site-packages:/data/roboframe/install/inference_service/lib/python3.12/site-packages:/data/roboframe/install/hardware_mock/lib/python3.12/site-packages:/data/roboframe/install/action_dispatch/lib/python3.12/site-packages:/data/roboframe/install/feetech_sdk/lib/python3.12/site-packages:/data/roboframe/install/so101_sdk/lib/python3.12/site-packages:/data/roboframe/install/so101_hardware/lib/python3.12/site-packages:/data/roboframe/install/so101_description/lib/python3.12/site-packages:/data/roboframe/install/so101_motion/lib/python3.12/site-packages:/data/roboframe/install/so101_suite/lib/python3.12/site-packages:/data/roboframe/install/so101_robot/lib/python3.12/site-packages:/data/roboframe/install/robot_runtime/lib/python3.12/site-packages:/data/roboframe/install/task_dispatch/lib/python3.12/site-packages:/data/roboframe/install/dataset_tools/lib/python3.12/site-packages:/sys_prod/robot/out/lib/python3.12/site-packages:/sys_prod/robot/install/lib/python3.12/site-packages:$PYTHONPATH

# AMENT + ROS 2 (isolated install: each package dir is its own ament prefix)
export AMENT_PREFIX_PATH=/sys_prod/robot/install:/data/roboframe/install:/data/roboframe/install/ibrobot_msgs:/data/roboframe/install/tensormsg:/data/roboframe/install/embodied_common:/data/roboframe/install/inference_manifest:/data/roboframe/install/ibrobot_tracing:/data/roboframe/install/robot_config:/data/roboframe/install/inference_service:/data/roboframe/install/hardware_mock:/data/roboframe/install/action_dispatch:/data/roboframe/install/feetech_sdk:/data/roboframe/install/so101_sdk:/data/roboframe/install/so101_hardware:/data/roboframe/install/so101_description:/data/roboframe/install/so101_motion:/data/roboframe/install/so101_suite:/data/roboframe/install/so101_robot:/data/roboframe/install/robot_runtime:/data/roboframe/install/task_dispatch:/data/roboframe/install/dataset_tools:$AMENT_PREFIX_PATH
export ROS_DISTRO=humble
export ROS_VERSION=2
export ROS_PYTHON_VERSION=3
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
