# ibrobot_ws 通用开发环境脚本 (支持 Bash & Zsh)
# 使用方法: source .shrc_local

# 0. 颜色定义 & 状态收集
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
GRAY='\033[0;90m'
NC='\033[0m'
_IB_STEPS=()        # 已生效的步骤
_IB_SKIPPED=()      # 未生效/跳过的步骤

# 1. 加载基础 ROS 2 环境
if [ -f "/opt/ros/humble/setup.sh" ]; then
    source /opt/ros/humble/setup.sh
    # openEuler installs several ROS runtime dependencies (for example
    # iceoryx_binding_c used by rmw_cyclonedds_cpp) under lib64, while the
    # generated ROS setup only exports lib. Keep both standard ROS library
    # directories visible to the dynamic linker.
    export LD_LIBRARY_PATH="/opt/ros/humble/lib64:/opt/ros/humble/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    _IB_STEPS+=("ROS 2 Humble")
else
    _IB_SKIPPED+=("ROS 2 Humble (未找到 /opt/ros/humble)")
fi

# 2. 如果当前在 conda 虚拟环境中，先退出
if [ -n "$CONDA_DEFAULT_ENV" ] && command -v conda &> /dev/null; then
    conda deactivate
    _IB_STEPS+=("退出 conda 环境")
fi

# 3. 激活虚拟环境
# Worktrees may intentionally reuse a main checkout venv: activate that venv
# first, then source this file; the already-active Python 3.10 venv wins (see
# .agents/skills/ibrobot-worktree-env). Otherwise use the workspace-local venv.
# Never guess a venv from hardcoded user directories, and fail closed when the
# local venv has the wrong Python version instead of silently skipping it.
_IB_VENV_ACTIVATE=""
if [ -n "${VIRTUAL_ENV:-}" ] && [ -f "${VIRTUAL_ENV}/bin/activate" ] && [ "$("${VIRTUAL_ENV}/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" = "3.10" ]; then
    _IB_VENV_ACTIVATE="${VIRTUAL_ENV}/bin/activate"
elif [ -f "venv/bin/activate" ]; then
    if [ "$(venv/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" != "3.10" ]; then
        echo "ERROR: venv/bin/python is not Python 3.10; recreate the workspace venv via ./scripts/setup.sh" >&2
        return 1 2>/dev/null || exit 1
    fi
    _IB_VENV_ACTIVATE="venv/bin/activate"
fi
if [ -n "${_IB_VENV_ACTIVATE}" ]; then
    source "${_IB_VENV_ACTIVATE}"
    _IB_STEPS+=("Python venv")
else
    _IB_SKIPPED+=("Python venv (未找到 venv/bin/activate; worktree 请先激活主仓库 venv 再 source 本脚本)")
fi

# 4. 禁用用户 site-packages，避免 ~/.local 与 workspace venv 混装
export PYTHONNOUSERSITE=1

# 5. 设置 PYTHONPATH
# 确保优先使用 venv 和 libs 中的源码，使用绝对路径以支持跨目录调用
# 获取本脚本所在目录（兼容 bash/zsh × 交互/非交互）：
#   bash 用 BASH_SOURCE[0]；zsh 用 prompt escape %x（eval 隔离语法，避免 bash 解析报错）；
#   两者都不可用时回退 ${0}，最终兜底 PWD（要求调用前已 cd 到 workspace 根目录）。
if [ -n "${BASH_VERSION:-}" ]; then
    _IB_SELF="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
    eval '_IB_SELF="${(%):-%x}"'
else
    _IB_SELF="${0}"
fi
WORKSPACE_DIR="$(cd "$(dirname "${_IB_SELF:-.}")" 2>/dev/null && pwd)" || WORKSPACE_DIR="$(pwd)"
[ -z "${WORKSPACE_DIR:-}" ] && WORKSPACE_DIR="$(pwd)"
export WORKSPACE="${WORKSPACE_DIR}"
unset _IB_SELF
PYTHON_VER="$(python3 -c 'import sys; print(f"python{sys.version_info.major}.{sys.version_info.minor}")')"
export PYTHONPATH="${WORKSPACE_DIR}/libs/lerobot/src:${WORKSPACE_DIR}/venv/lib/${PYTHON_VER}/site-packages:${PYTHONPATH}"
_IB_STEPS+=("PYTHONPATH (lerobot)")

# 6. 日志与调试增强
export RCUTILS_COLORIZED_OUTPUT=1
export PYTHONUNBUFFERED=1

# 7. 加载本地编译后的包 (如果已编译)
if [ -f "${WORKSPACE_DIR}/install/setup.sh" ]; then
    source "${WORKSPACE_DIR}/install/setup.sh"
    _IB_STEPS+=("workspace install/")
else
    _IB_SKIPPED+=("workspace install/ (尚未 colcon build)")
fi

# 7.1 加载 CANN (华为昇腾 Ascend) 环境，如已安装
# 按优先级依次探测常见安装位置
_CANN_CANDIDATES=(
    "${ASCEND_TOOLKIT_HOME}/set_env.sh"
    "/usr/local/Ascend/ascend-toolkit/set_env.sh"
    "${HOME}/Ascend/ascend-toolkit/set_env.sh"
)
_CANN_LOADED=""
for _cann_env in "${_CANN_CANDIDATES[@]}"; do
    if [ -n "${_cann_env}" ] && [ -f "${_cann_env}" ]; then
        source "${_cann_env}"
        _CANN_LOADED="${_cann_env}"
        break
    fi
done
if [ -n "${_CANN_LOADED}" ]; then
    # set_env.sh 是 CANN 环境的唯一入口：ACT/PI0.5/RAM++/SigLIP2 的 OM runtime 已依赖它提供
    # PYTHONPATH 与 LD_LIBRARY_PATH，此处不再重复推导，避免混用不同 CANN 版本或遮蔽 venv 依赖。
    _IB_STEPS+=("CANN (${_CANN_LOADED})")

    # CANN/ATC 的 TIK C++ 编译阶段可能无法自动找到系统 libstdc++ 头文件。
    # 根据当前编译器版本和目标三元组追加实际存在的目录，兼容 openEuler/Ubuntu
    # 以及 aarch64/x86_64，避免硬编码 /usr/include/c++/12/aarch64-openEuler-linux。
    if command -v g++ &> /dev/null; then
        _CXX_VERSION="$(g++ -dumpversion 2>/dev/null)"
        _CXX_FULL_VERSION="$(g++ -dumpfullversion -dumpversion 2>/dev/null)"
        _CXX_TARGET="$(g++ -dumpmachine 2>/dev/null)"
        _CXX_ROOT="/usr/include/c++/${_CXX_VERSION}"
        _CXX_INCLUDE_DIRS=()
        for _cxx_dir in \
            "${_CXX_ROOT}" \
            "${_CXX_ROOT}/backward" \
            "${_CXX_ROOT}/${_CXX_TARGET}"; do
            if [ -d "${_cxx_dir}" ]; then
                _CXX_INCLUDE_DIRS+=("${_cxx_dir}")
            fi
        done
        if [ "${#_CXX_INCLUDE_DIRS[@]}" -gt 0 ]; then
            _CXX_INCLUDE_PATH="$(IFS=:; echo "${_CXX_INCLUDE_DIRS[*]}")"
            export CPLUS_INCLUDE_PATH="${_CXX_INCLUDE_PATH}${CPLUS_INCLUDE_PATH:+:${CPLUS_INCLUDE_PATH}}"
            _IB_STEPS+=("CANN C++ headers (${_CXX_TARGET}, GCC ${_CXX_FULL_VERSION})")
        else
            _IB_SKIPPED+=("CANN C++ headers (未找到 ${_CXX_ROOT})")
        fi
        unset _CXX_VERSION _CXX_FULL_VERSION _CXX_TARGET _CXX_ROOT _CXX_INCLUDE_DIRS _CXX_INCLUDE_PATH _cxx_dir
    else
        _IB_SKIPPED+=("CANN C++ headers (未找到 g++)")
    fi
else
    _IB_SKIPPED+=("CANN (未检测到 Ascend toolkit)")
fi
unset _CANN_CANDIDATES _cann_env _CANN_LOADED

# 7.2 加载 workspace-owned LIBERO benchmark 配置 (如果已由 setup.sh --with-benchmark 生成)
_IB_LIBERO_CONFIG_PATH="${WORKSPACE_DIR}/venv/ibrobot_libero"
if [ -f "${_IB_LIBERO_CONFIG_PATH}/config.yaml" ]; then
    export LIBERO_CONFIG_PATH="${_IB_LIBERO_CONFIG_PATH}"
    _IB_STEPS+=("LIBERO benchmark config")
fi
unset _IB_LIBERO_CONFIG_PATH

# 8. 别名设置
alias cb='python3 -m colcon build --symlink-install --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release'
alias cbp='python3 -m colcon build --symlink-install --merge-install --packages-select'
alias src='source install/setup.sh'

# 9. 欢迎信息 + 步骤摘要 (仅在交互式 Shell 中输出)
if [[ $- == *i* ]]; then
    echo -e "${GREEN}[ibrobot_ws]${NC} 环境已就绪！"
    for _s in "${_IB_STEPS[@]}";   do echo -e "  ${GREEN}✔${NC} ${_s}"; done
    for _s in "${_IB_SKIPPED[@]}"; do echo -e "  ${GRAY}✘ ${_s}${NC}"; done
    echo -e "常用指令: ${YELLOW}cb${NC} (编译全部), ${YELLOW}cbp${NC} (编译指定包), ${YELLOW}src${NC} (刷新环境)"
    unset _s
fi
unset _IB_STEPS _IB_SKIPPED _IB_VENV_ACTIVATE
