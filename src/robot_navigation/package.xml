<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_navigation</name>
  <version>0.0.0</version>
  <description>Robot navigation package with Nav2 client, voice control, and chassis driver</description>
  <maintainer email="yanhan31@huawei.com">yanhan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <!-- Launch-builder registration (openspec change
       ``migrate-business-launch-builders``): launch_builders/navigation.py
       contributes the navigation entry to robot_config's launch registry
       through the ibrobot.launch_builders entry point group and imports
       robot_config's retained helpers (fast_lio / static_tf /
       runtime provider lookup) at build time. The dependency is one way:
       robot_config does not depend on this package. -->
  <depend>robot_config</depend>
  <depend>action_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_msgs</depend>
  <!-- Moved from robot_config with the navigation launch builders (openspec
       change ``migrate-business-launch-builders``, task B.8); nav2_bringup /
       robot_localization / rviz2 were already declared here. -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <!-- Nav2 dependencies -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>ibrobot_msgs</exec_depend>
  <!-- Navigation admission client: contract names + RuntimeStatus -->
  <exec_depend>robot_runtime</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- Python dependencies -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pyaudio</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- The migrated launch-builder tests import robot_config's loader and
       registry (openspec change ``migrate-business-launch-builders``). -->
  <test_depend>robot_config</test_depend>
  <!-- LeKiwi lidar-odometry gate (test/test_lidar_odometry_gate.py, openspec
       lekiwi-gazebo-runtime-platform D14.3, MuJoCo leg since
       lekiwi-mujoco-runtime-platform D14): the gate launches the composed
       robot_config navigation stage with this package's Nav2 chain on the
       lekiwi_robot runtime's physics platforms (Gazebo and MuJoCo, one leg
       each), inside a sim_models scene; on Gazebo, fast_lio is bridged over
       ros_gz_sim/ros_gz_bridge. It lives here, not in lekiwi_robot, so the
       runtime's dependency closure stays free of generic packages
       (scripts/verify_runtime_independence.sh). -->
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-matplotlib</test_depend>
  <test_depend>lekiwi_robot</test_depend>
  <test_depend>sim_models</test_depend>
  <test_depend>fast_lio</test_depend>
  <test_depend>ros_gz_sim</test_depend>
  <test_depend>ros_gz_bridge</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <!-- The gate's direct imports (<depend> covers build+exec scope only, the
       robot_config precedent): the environment probe, the require-or-skip
       rule, the collection-safety helper and ground truth come from
       robot_runtime.testing; the gate probes RuntimeStatus from
       ibrobot_msgs. -->
  <test_depend>robot_runtime</test_depend>
  <test_depend>ibrobot_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
