{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IB-Robot Public Robot Interface Description v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "robot",
    "execution",
    "interfaces",
    "digest",
    "states"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "runtime_name",
        "runtime_version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "type": {
          "$ref": "#/$defs/nonempty"
        },
        "runtime_name": {
          "$ref": "#/$defs/nonempty"
        },
        "runtime_version": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "execution": {
      "enum": [
        "physical",
        "simulated"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interfaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/interface"
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "model": {
      "$ref": "#/$defs/model"
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_]*)(?:/[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "image_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "encoding"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "qos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliability",
        "durability",
        "history",
        "depth"
      ],
      "properties": {
        "reliability": {
          "enum": [
            "best_effort",
            "reliable"
          ]
        },
        "durability": {
          "enum": [
            "volatile",
            "transient_local"
          ]
        },
        "history": {
          "const": "keep_last"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "kind",
        "direction",
        "endpoint",
        "message_type"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/nonempty"
        },
        "kind": {
          "enum": [
            "topic",
            "service",
            "action"
          ]
        },
        "direction": {
          "enum": [
            "publish",
            "subscribe",
            "serve"
          ]
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "message_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*/(msg|srv|action)/[A-Za-z][A-Za-z0-9_]*$"
        },
        "qos": {
          "$ref": "#/$defs/qos"
        },
        "frame_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "camera_info_topic": {
          "$ref": "#/$defs/endpoint"
        },
        "rate_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "configured_profile": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/image_profile"
            }
          ]
        },
        "supported_profiles": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/image_profile"
          }
        },
        "modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "joint_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "limits": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number"
          }
        },
        "joint_limits": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "position_min": {
                "type": "number"
              },
              "position_max": {
                "type": "number"
              },
              "velocity_max": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "target_group": {
          "$ref": "#/$defs/nonempty"
        },
        "base_frame": {
          "$ref": "#/$defs/nonempty"
        },
        "tool_frame": {
          "$ref": "#/$defs/nonempty"
        },
        "command_stale_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pose_reference": {
          "enum": [
            "clutch_relative"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "topic"
              }
            }
          },
          "then": {
            "required": [
              "qos"
            ],
            "properties": {
              "direction": {
                "enum": [
                  "publish",
                  "subscribe"
                ]
              },
              "message_type": {
                "pattern": "/msg/"
              }
            }
          },
          "else": {
            "properties": {
              "direction": {
                "const": "serve"
              }
            },
            "not": {
              "required": [
                "qos"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service"
              }
            }
          },
          "then": {
            "properties": {
              "message_type": {
                "pattern": "/srv/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "message_type": {
                "pattern": "/action/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "message_type": {
                "const": "sensor_msgs/msg/Image"
              }
            }
          },
          "then": {
            "required": [
              "configured_profile",
              "supported_profiles",
              "camera_info_topic",
              "frame_id"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "configured_profile"
                  ]
                },
                {
                  "required": [
                    "supported_profiles"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "conversion_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "span",
        "offset"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "span": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "joint_groups",
        "joint_limits",
        "home_positions",
        "frames",
        "joint_conversions",
        "joint_conversions_fingerprint"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "authority": {
          "enum": [
            "calibration",
            "urdf"
          ]
        },
        "joint_groups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all",
            "arm",
            "gripper",
            "base"
          ],
          "properties": {
            "all": {
              "$ref": "#/$defs/joint_names"
            },
            "arm": {
              "$ref": "#/$defs/joint_names_or_empty"
            },
            "gripper": {
              "$ref": "#/$defs/joint_names_or_empty"
            },
            "base": {
              "$ref": "#/$defs/joint_names_or_empty"
            }
          }
        },
        "joint_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "home_positions": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "frames": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "joint_conversions": {
          "type": "object"
        },
        "joint_conversions_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "joint_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observed_profile",
        "observed_frame_id",
        "last_seen",
        "detail"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "ready",
            "mismatch",
            "stale"
          ]
        },
        "observed_profile": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/image_profile"
            }
          ]
        },
        "observed_frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "joint_names_or_empty": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    }
  }
}
