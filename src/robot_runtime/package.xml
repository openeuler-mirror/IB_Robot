<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_runtime</name>
  <version>0.1.0</version>
  <description>
    Robot runtime contract layer: canonical capability vocabulary, the runtime
    facade node that maps the contract onto ros2_control controller switching,
    the mock runtime reference implementation, launch-time capability
    reconciliation, and the parameterized conformance suite every runtime
    must pass.
  </description>
  <maintainer email="wuxiaoqiang.rtos@huawei.com">xqw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>ibrobot_msgs</depend>
  <depend>python3-yaml</depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- MuJoCo embodiment (so101-mujoco-runtime-platform D2/D3): the provider
       composes the robot+scene model through sim_models and starts the
       mujoco_ros2_control simulator + controller manager process.
       0.1.2 floor (upgrade-mujoco-ros2-control-0-1 D1): the CameraPlugin
       parameter path needs >= 0.1.0; rosdep does not enforce versions, the
       runtime check (robot_runtime.mujoco.check_simulator_versions) is the
       real guard. -->
  <exec_depend>sim_models</exec_depend>
  <exec_depend version_gte="0.1.2">mujoco_ros2_control</exec_depend>
  <!-- lekiwi-mujoco-runtime-platform D5/D11: the MuJoCo lidar composition.
       mujoco_3d_lidar registers the mujoco.plugin.lidar engine extension the
       composed model declares (the C++ simulator loads it from the ament
       mujoco_plugins index); imu_sensor_broadcaster publishes the generated
       integrated-IMU controller's stream. 0.1.2 floor: the release paired
       with mujoco_ros2_control 0.1.2 (verify_env.sh checks the same floor). -->
  <exec_depend version_gte="0.1.2">mujoco_3d_lidar</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
