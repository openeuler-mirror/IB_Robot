<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skill_catalog</name>
  <version>0.1.0</version>
  <description>Lightweight skill package compiler and immutable catalog registry for IB-Robot</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>embodied_common</depend>
  <depend>rclpy</depend>
  <depend>ibrobot_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>robot_config</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
