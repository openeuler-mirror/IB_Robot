<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>benchmark_runtime</name>
  <version>0.0.1</version>
  <description>Generic ROS runtime for IB-Robot benchmark evaluation</description>
  <maintainer email="ib-robot@example.com">ib-robot</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ibrobot_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tensormsg</depend>
  <depend>observation_transport</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
