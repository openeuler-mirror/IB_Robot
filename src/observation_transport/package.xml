<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>observation_transport</name>
  <version>0.3.0</version>
  <description>Provider-neutral direct-frame video transport for IB-Robot observations.</description>
  <maintainer email="ib-robot@example.com">ib-robot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>tensormsg</depend>
  <depend>rclpy</depend>
  <depend>ibrobot_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-av</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
