<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101_dual">

  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="port_1" default=""/>
  <xacro:arg name="calib_file_left" default=""/>
  <xacro:arg name="port_2" default=""/>
  <xacro:arg name="calib_file_right" default=""/>
  <xacro:arg name="reset_positions" default="{}"/>

  <link name="base_link"/>

  <xacro:macro name="so101_arm" params="side mount_y port calib_file">
    <link name="base_${side}"/>
    <link name="shoulder_${side}"/>
    <link name="upper_arm_${side}"/>
    <link name="lower_arm_${side}"/>
    <link name="wrist_${side}"/>
    <link name="gripper_${side}"/>
    <link name="jaw_${side}"/>

    <joint name="base_mount_${side}" type="fixed">
      <parent link="base_link"/>
      <child link="base_${side}"/>
      <origin xyz="0 ${mount_y} 0" rpy="0 0 0"/>
    </joint>

    <joint name="joint1_${side}" type="revolute">
      <origin xyz="0.0207909 -0.0230745 0.0948817" rpy="-3.14159 6.03684e-16 1.5708"/>
      <parent link="base_${side}"/>
      <child link="shoulder_${side}"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-2.0693" upper="2.0709"/>
    </joint>

    <joint name="joint2_${side}" type="revolute">
      <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
      <parent link="shoulder_${side}"/>
      <child link="upper_arm_${side}"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-1.92" upper="1.92"/>
    </joint>

    <joint name="joint3_${side}" type="revolute">
      <origin xyz="-0.11257 -0.028 2.46331e-16" rpy="-1.22818e-15 5.75928e-16 1.5708"/>
      <parent link="upper_arm_${side}"/>
      <child link="lower_arm_${side}"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-1.6813" upper="1.6828"/>
    </joint>

    <joint name="joint4_${side}" type="revolute">
      <origin xyz="-0.1349 0.0052 1.65232e-16" rpy="3.2474e-15 2.86219e-15 -1.5708"/>
      <parent link="lower_arm_${side}"/>
      <child link="wrist_${side}"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
    </joint>

    <joint name="joint5_${side}" type="revolute">
      <origin xyz="0 -0.0611 0.0181" rpy="1.5708 -9.38083e-08 3.14159"/>
      <parent link="wrist_${side}"/>
      <child link="gripper_${side}"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-2.9115" upper="2.9115"/>
    </joint>

    <joint name="joint6_${side}" type="revolute">
      <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.14108e-17 -1.38655e-14"/>
      <parent link="gripper_${side}"/>
      <child link="jaw_${side}"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="0.0" upper="1.0"/>
    </joint>

    <ros2_control name="${side}_so101_system" type="system">
      <hardware>
        <xacro:unless value="$(arg use_sim)">
          <plugin>so101_hardware/SO101SystemHardware</plugin>
          <param name="port">${port}</param>
          <param name="calib_file">${calib_file}</param>
          <param name="reset_positions">$(arg reset_positions)</param>
        </xacro:unless>
      </hardware>

      <joint name="joint1_${side}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><param name="id">1</param></joint>
      <joint name="joint2_${side}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><param name="id">2</param></joint>
      <joint name="joint3_${side}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><param name="id">3</param></joint>
      <joint name="joint4_${side}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><param name="id">4</param></joint>
      <joint name="joint5_${side}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><param name="id">5</param></joint>
      <joint name="joint6_${side}"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><param name="id">6</param></joint>
    </ros2_control>
  </xacro:macro>

  <xacro:so101_arm side="left" mount_y="0.18" port="$(arg port_1)" calib_file="$(arg calib_file_left)"/>
  <xacro:so101_arm side="right" mount_y="-0.18" port="$(arg port_2)" calib_file="$(arg calib_file_right)"/>

</robot>
