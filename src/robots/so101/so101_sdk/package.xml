<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_sdk</name>
  <version>0.1.0</version>
  <description>
    ROS-free SO-101 arm SDK: follower lifecycle with calibration ownership,
    read-only leader arm, and SI-unit named-joint state on top of feetech_sdk.
  </description>
  <maintainer email="wuxiaoqiang.rtos@huawei.com">xqw</maintainer>
  <license>Apache-2.0</license>

  <!-- Runtime: plain C++ libraries only. No ROS interface dependencies. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>feetech_sdk</depend>
  <depend>nlohmann-json-dev</depend>
  <build_depend>python3-dev</build_depend>
  <build_depend>pybind11-dev</build_depend>
  <exec_depend>python3</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
