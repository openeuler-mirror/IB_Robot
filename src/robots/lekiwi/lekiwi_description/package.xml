<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_description</name>
  <version>0.0.1</version>
  <description>URDF, meshes, and robot description for LeKiwi robot</description>
  <maintainer email="adityakamath@live.com">Aditya Kamath (Kamath Robotics)</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependency for processing xacro files -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>lekiwi_hardware</exec_depend>
  <!-- lekiwi_assembled.urdf.xacro includes the SO-101 arm description: the
       LeKiwi arm IS an SO-101 arm, so the geometry is reused, not forked. -->
  <exec_depend>so101_description</exec_depend>

  <!-- test_mujoco_template.py composes the shipped MJCF template through the
       real composition path (lekiwi-mujoco-runtime-platform D2). -->
  <test_depend>sim_models</test_depend>
  <!-- CMakeLists finds ament_cmake_pytest (ament_add_pytest_test) and the
       test imports pytest directly (review round 1). -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
