<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">

  <!--
    Assembled URDF: simplified chassis + SO101 arm.
    Replaces CAD-exported lekiwi_car.urdf for real-robot hardware driving.
    Joint names "1"-"9" match the full LeKiwi controller configuration.
  -->

  <!-- Arguments -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="port" default="/dev/ttyACM0"/>
  <xacro:arg name="calib_file" default=""/>
  <xacro:arg name="base_only" default="false"/>
  <!-- simulated: run the LeKiwi hardware plugin on the SDK simulated
       transport. This is NOT use_sim, which swaps in a physics-engine
       plugin instead; simulated keeps the production adapter path and
       only replaces the serial bus, which is what conformance exercises. -->
  <xacro:arg name="simulated" default="false"/>
  <xacro:arg name="sim_plugin" default="gz_ros2_control/GazeboSimSystem"/>
  <xacro:arg name="mujoco_model" default=""/>
  <!-- gz_ros2_control: always passed by render_gazebo_description (accepted
       even when unused); sim_effort_state is accepted and ignored here: this
       profile advertises no joint.current interface (D2). -->
  <xacro:arg name="gz_ros2_control_parameters_file" default=""/>
  <xacro:arg name="sim_effort_state" default="false"/>
  <!-- Gazebo-only chassis treatment (D2): gated by use_sim AND the gz plugin
       so the MuJoCo platform (a different sim_plugin) and every physical/SDK
       render (use_sim false) keep their exact pre-change output. -->
  <xacro:property name="gz_sim" value="${'$(arg use_sim)' == 'true' and '$(arg sim_plugin)' == 'gz_ros2_control/GazeboSimSystem'}"/>
  <!-- Wheel joint axis under Gazebo: the SDK's mount angles (150/-90/30 deg)
       are each wheel's POSITIVE-spin drive direction, which is antiparallel
       to the URDF joints' +z rotation as simulated (positive rotation about
       +z drives the base the opposite way). Flipping the axis under the gz
       gate makes the simulated joint velocity/position convention match the
       physical motors' — the same base_node kinematics then drive and
       odometry-integrate identically on both executions (D3/D4). -->
  <xacro:property name="wheel_axis_z" value="${-1 if gz_sim else 1}"/>

  <!-- Chassis geometry/control properties (does not emit links/joints) -->
  <xacro:include filename="$(find lekiwi_description)/urdf/base.common.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/base.control.xacro"/>

  <xacro:unless value="$(arg base_only)">
    <!-- SO101 arm (joints "1"-"6", links: world->base->shoulder->...->jaw) -->
    <xacro:include filename="$(find so101_description)/urdf/lerobot/so101/so101_base.xacro"/>
  </xacro:unless>

  <!-- ============================================ -->
  <!-- Materials                                    -->
  <!-- ============================================ -->
  <material name="light_grey">
    <color rgba="${light_grey_rgba}"/>
  </material>
  <material name="charcoal">
    <color rgba="${charcoal_rgba}"/>
  </material>

  <!-- ============================================ -->
  <!-- Chassis Links                                -->
  <!-- ============================================ -->

  <!-- Base link (URDF root — EKF publishes odom → base_link) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <!-- Left wheel link -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <!-- Gazebo: cylinder collision (legacy macro sizes, D2) -->
    <xacro:if value="${gz_sim}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.025"/>
        </geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="${gz_sim}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Back wheel link -->
  <link name="back_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <!-- Gazebo: cylinder collision (legacy macro sizes, D2) -->
    <xacro:if value="${gz_sim}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.025"/>
        </geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="${gz_sim}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Right wheel link -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <!-- Gazebo: cylinder collision (legacy macro sizes, D2) -->
    <xacro:if value="${gz_sim}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.025"/>
        </geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="${gz_sim}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Anisotropic friction approximating the omni wheels on Gazebo (D2):
       the validated legacy treatment — high friction along each wheel's
       rolling direction (fdir1 in the wheel link frame), low friction along
       the spin axis — repeated per wheel link. -->
  <xacro:if value="${gz_sim}">
    <gazebo reference="left_wheel_link">
      <mu1>0.8</mu1>
      <mu2>0.05</mu2>
      <fdir1>0 1 0</fdir1>
      <kp>10000000.0</kp>
      <kd>10.0</kd>
    </gazebo>
    <gazebo reference="back_wheel_link">
      <mu1>0.8</mu1>
      <mu2>0.05</mu2>
      <fdir1>0 1 0</fdir1>
      <kp>10000000.0</kp>
      <kd>10.0</kd>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>0.8</mu1>
      <mu2>0.05</mu2>
      <fdir1>0 1 0</fdir1>
      <kp>10000000.0</kp>
      <kd>10.0</kd>
    </gazebo>
  </xacro:if>

  <!-- ============================================ -->
  <!-- Chassis Joints                               -->
  <!-- ============================================ -->

  <!-- Left wheel: 60 deg anti-clockwise from +X -->
  <joint name="7" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_base_radius * cos(offset)} ${wheel_base_radius * sin(offset)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset}"/>
    <axis xyz="0 0 ${wheel_axis_z}"/>
    <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
  </joint>

  <!-- Back wheel: 180 deg anti-clockwise from +X -->
  <joint name="8" type="continuous">
    <parent link="base_link"/>
    <child link="back_wheel_link"/>
    <origin xyz="${wheel_base_radius * cos(offset + theta)} ${wheel_base_radius * sin(offset + theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset + theta}"/>
    <axis xyz="0 0 ${wheel_axis_z}"/>
    <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
  </joint>

  <!-- Right wheel: 300 deg anti-clockwise from +X -->
  <joint name="9" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_base_radius * cos(offset - theta)} ${wheel_base_radius * sin(offset - theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset - theta}"/>
    <axis xyz="0 0 ${wheel_axis_z}"/>
    <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
  </joint>

  <xacro:unless value="$(arg base_only)">
    <!-- ============================================ -->
    <!-- Arm Mounting: base_link -> world (arm base)  -->
    <!-- ============================================ -->
    <joint name="base_to_arm" type="fixed">
      <parent link="base_link"/>
      <child link="world"/>
      <origin xyz="0.06 -0.02 0.02" rpy="0 0 1.5708"/>
    </joint>
  </xacro:unless>

  <!-- ============================================ -->
  <!-- Gazebo (gz_ros2_control)                     -->
  <!-- ============================================ -->
  <!-- The gz system plugin reads the profile's controller parameters (D2);
       no sensors here — the runtime generates them from the peripheral
       inventory (D5). -->
  <xacro:if value="${gz_sim}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg gz_ros2_control_parameters_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ============================================ -->
  <!-- ros2_control                                 -->
  <!-- ============================================ -->
  <ros2_control name="RobotSystem" type="system">
    <xacro:if value="$(arg use_sim)">
      <hardware>
        <plugin>$(arg sim_plugin)</plugin>
        <xacro:if value="${'$(arg mujoco_model)' != ''}">
          <param name="mujoco_model">$(arg mujoco_model)</param>
        </xacro:if>
      </hardware>
    </xacro:if>

    <xacro:unless value="$(arg use_sim)">
      <hardware>
        <plugin>lekiwi_hardware/LeKiwiSystemHardware</plugin>
        <param name="port">$(arg port)</param>
        <param name="calib_file">$(arg calib_file)</param>
        <param name="simulated">$(arg simulated)</param>
      </hardware>
    </xacro:unless>

    <xacro:unless value="$(arg base_only)">
      <!-- ===== Arm joints 1-6: position control ===== -->
      <joint name="1">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">1</param>
      </joint>

      <joint name="2">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">2</param>
      </joint>

      <joint name="3">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">3</param>
      </joint>

      <joint name="4">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">4</param>
      </joint>

      <joint name="5">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">5</param>
      </joint>

      <joint name="6">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">6</param>
      </joint>
    </xacro:unless>

    <!-- ===== Base joints 7-9: velocity control ===== -->
    <joint name="7">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="id">7</param>
    </joint>

    <joint name="8">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="id">8</param>
    </joint>

    <joint name="9">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="id">9</param>
    </joint>

  </ros2_control>

</robot>
