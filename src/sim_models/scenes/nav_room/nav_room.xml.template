<mujoco model="nav_room">
  <!-- nav_room MuJoCo scene — generated from nav_room.xml.template
       (lekiwi-mujoco-runtime-platform D8).

       The MuJoCo counterpart of nav_room.world.template: exactly the
       layout.yaml static_geometry (same names, world poses, sizes — MJCF
       boxes carry HALF-extents, cylinders size="radius half-length"), so the
       navigation map robot_navigation/config/maps/sim_map.yaml stays valid
       and the D14.5 gate route clears the same walls. Static bodies only —
       no joints; the robot spawns at layout.yaml's robot_spawn.

       Unlike the shared ``empty`` scene there is ONE visible floor plane at
       z = 0 (priority 1, friction as empty): the robot's wheels rest on it
       and the lidar rays see it — no invisible support/observation split.
       {{ROBOT_XML_PATH}} — absolute path to the robot MJCF; the composition
       API (scene_compiler.compose_mujoco_model) fills it. -->
  <include file="{{ROBOT_XML_PATH}}"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" specular="0.0 0.0 0.0"/>
    <rgba haze="0.15 0.25 0.35 1.0"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0.0 0.0 3.5" dir="0.0 0.0 -1.0" directional="true"/>
    <!-- Visible floor at z = 0: support AND observation surface (D8). The
         priority-1 friction keeps the contact parameters from fighting the
         scene-independent support planes of other scenes; robots whose
         wheels carry their own priority outrank it. -->
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane"
          material="groundplane" priority="1" friction="0.8 0.1 0.01"/>

    <!-- Enclosed room: 4m x 4m, walls 0.1m thick, room from (-2,-2) to (2,2).
         MJCF box size is the HALF-extent (layout sizes are full extents). -->
    <body name="wall_north" pos="0 2 0.5">
      <geom name="wall_north" type="box" size="2.1 0.05 0.5" rgba="0.6 0.6 0.6 1"/>
    </body>
    <body name="wall_south" pos="0 -2 0.5">
      <geom name="wall_south" type="box" size="2.1 0.05 0.5" rgba="0.6 0.6 0.6 1"/>
    </body>
    <body name="wall_east" pos="2 0 0.5">
      <geom name="wall_east" type="box" size="0.05 2.1 0.5" rgba="0.6 0.6 0.6 1"/>
    </body>
    <body name="wall_west" pos="-2 0 0.5">
      <geom name="wall_west" type="box" size="0.05 2.1 0.5" rgba="0.6 0.6 0.6 1"/>
    </body>

    <!-- Interior obstacles (layout.yaml static_geometry). -->
    <body name="obstacle_box" pos="0 0 0.25">
      <geom name="obstacle_box" type="box" size="0.2 0.2 0.25" rgba="0.9 0.3 0.3 1"/>
    </body>
    <!-- Cylinder: MJCF size is "radius half-length" (layout: [0.2, 0.6]). -->
    <body name="obstacle_cylinder" pos="1.0 -0.5 0.3">
      <geom name="obstacle_cylinder" type="cylinder" size="0.2 0.3" rgba="0.3 0.3 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
