<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_config</name>
  <version>0.0.1</version>
  <description>Unified robot configuration system for ros2_control and peripherals</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ibrobot_msgs</depend>
  <depend>robot_runtime</depend>
  <!-- docs/testing.md: every sibling imported by tests is declared as an
       explicit test_depend; <depend> covers build+exec scope only. -->
  <test_depend>robot_runtime</test_depend>
  <test_depend>ibrobot_msgs</test_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>rosgraph_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>embodied_common</depend>
  <depend>inference_manifest</depend>
  <depend>ament_index_python</depend>
  <depend>ibrobot_tracing</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Auxiliary hand actuator nodes launched by this package; the teleop
       wiring and the hand_sources entry moved to robot_teleop (openspec
       changes ``migrate-business-launch-builders`` and
       ``migrate-hand-sources-to-robot-teleop``), which now depends on
       robot_config. -->
  <exec_depend>aero_hand_hardware</exec_depend>

  <!-- Camera drivers (executed, not linked) -->
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ldlidar_ros2</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <!-- ALSA audio device owners for the provider-less legacy audio_io entry
       (runtime-owned-audio-io). Delete both once every deployment sets
       runtime.provider: provider deployments launch these nodes from the
       robot runtime's peripheral list and declare the dependency there. -->
  <exec_depend>audio_capture</exec_depend>
  <exec_depend>audio_play</exec_depend>

  <!-- ros2_control -->
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Gazebo simulation -->
  <exec_depend>gz_ros2_control</exec_depend>
  <!-- Every Gazebo world the generic launch runs comes from sim_models scenes
       (the empty scene is the fallback when simulation.scene is unset). -->
  <exec_depend>sim_models</exec_depend>

  <!-- MuJoCo simulation. 0.1.2 floor (upgrade-mujoco-ros2-control-0-1 D1);
       rosdep does not enforce versions, the runtime check is the guard. -->
  <exec_depend version_gte="0.1.2">mujoco_ros2_control</exec_depend>

  <!-- TF -->
  <exec_depend>tf2_ros</exec_depend>


  <!-- Benchmark runtime launched when runtime.target=benchmark -->
  <exec_depend>benchmark_runtime</exec_depend>

  <!-- Tracing -->
  <exec_depend>tracetools</exec_depend>
  <exec_depend>tracetools_analysis</exec_depend>
  <exec_depend>ros2trace</exec_depend>
  <exec_depend>lttng-tools</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- new launch-builder tests compose/inspect sim_models scenes -->
  <test_depend>sim_models</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>lekiwi_description</test_depend>
  <test_depend>lekiwi_hardware</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>ros_gz_bridge</test_depend>
  <test_depend>ros_gz_sim</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
