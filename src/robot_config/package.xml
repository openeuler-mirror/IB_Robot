<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_config</name>
  <version>0.0.1</version>
  <description>Unified robot configuration system for ros2_control and peripherals</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ibrobot_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>rosgraph_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>embodied_common</depend>
  <depend>inference_manifest</depend>
  <depend>ament_index_python</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>robot_calibration</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Teleoperation and auxiliary hand nodes launched by this package -->
  <exec_depend>robot_teleop</exec_depend>
  <exec_depend>aero_hand_hardware</exec_depend>

  <!-- Camera drivers (executed, not linked) -->
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>ldlidar_ros2</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>omni_wheel_controller</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <depend>voice_asr_service</depend>
  <exec_depend>audio_capture</exec_depend>
  <exec_depend>audio_play</exec_depend>

  <!-- ros2_control -->
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Gazebo simulation -->
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- MuJoCo simulation -->
  <exec_depend>mujoco_ros2_control</exec_depend>

  <!-- TF -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Navigation bringup -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_navigation</exec_depend>

  <!-- Benchmark runtime launched when runtime.target=benchmark -->
  <exec_depend>benchmark_runtime</exec_depend>

  <!-- Tracing -->
  <exec_depend>tracetools</exec_depend>
  <exec_depend>tracetools_analysis</exec_depend>
  <exec_depend>ros2trace</exec_depend>
  <exec_depend>lttng-tools</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>lekiwi_description</test_depend>
  <test_depend>lekiwi_hardware</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>ros_gz_bridge</test_depend>
  <test_depend>ros_gz_sim</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
