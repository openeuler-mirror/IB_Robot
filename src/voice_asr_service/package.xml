<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voice_asr_service</name>
  <version>0.1.0</version>
  <description>Voice ASR Service for IB-Robot using sherpa-onnx</description>
  <maintainer email="dev@example.com">IB-Robot Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ibrobot_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>audio_common_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- Plotly/Matplotlib 仅 speech_direction_report 离线 CLI 渲染用,不在 base.txt;
       通过 setup.sh 的 with-diagnostics 开关或 requirements/diagnostics.txt 可选安装。
       rosdep 无 python3-plotly key,故不声明 exec_depend;运行时节点不 import。 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sherpa-onnx</exec_depend>
  <!-- speech_direction 链路重依赖 -->
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-onnxruntime</exec_depend>
  <!-- speech_direction 走标准 inference_manifest 契约 + inference_service ACL/Torch 后端。
       inference_manifest 是 bindings 契约的静态导入源（setup.py 不 import，节点运行时必导）。
        inference_service.backends.ascend 仅 Ascend ACL backend 运行时动态导入（torch/onnx 后端不导入），
       属可选运行时依赖；不在 package.xml 声明 exec_depend，否则会与 inference_service→robot_config→
       voice_asr_service 的既有 depend 链形成环，破坏 colcon 拓扑排序。 -->
  <exec_depend>inference_manifest</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
